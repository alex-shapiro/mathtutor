schema_version: 2
area: discrete-and-complexity
prefix: dis
summary: "Combinatorics, graph theory, algorithms, computational complexity, descriptive complexity / MDL."
motivation: """
  Combinatorial reasoning underlies counting in probability, capacity
  arguments in learning theory, and the design of attention masks.
  Graph theory is the substrate for GNNs, computation graphs, and
  spectral methods (Laplacian, mixing). Complexity bounds clarify
  what gradient-based learning and inference can possibly achieve.
  Kolmogorov complexity / MDL provide the philosophical floor for
  generalization arguments.
  """
cross_references:
  - foundations
  - linear-algebra
  - probability
  - information-theory

children:
  - id: dis.1
    name: "Combinatorics"
    description: "Counting and existence arguments."
    children:
      - id: dis.1.1
        name: "Permutations and combinations"
        description: "Counting arrangements and selections."
        prerequisites: [fnd.4.2, fnd.4.4.4]
      - id: dis.1.2
        name: "Generating functions"
        description: "Formal power series encoding sequences."
        prerequisites: [ana.1.8]
      - id: dis.1.3
        name: "Asymptotics of combinatorial sums"
        description: "Estimating the growth of counting sequences."
        children:
          - id: dis.1.3.1
            name: "Stirling's approximation"
            description: "n! ~ √(2πn)(n/e)ⁿ; the workhorse factorial estimate."
            prerequisites: [dis.1.2]
          - id: dis.1.3.2
            name: "Saddle-point and singularity analysis"
            description: "Complex-analytic asymptotics from a generating function's singularities."
            prerequisites: [dis.1.3.1, ana.9.4]
      - id: dis.1.4
        name: "Probabilistic method"
        description: "Existence proofs via random construction."
        prerequisites: [prob.1.4, fnd.4.3.3]

  - id: dis.2
    name: "Graph theory"
    description: "Structure and spectra of graphs."
    children:
      - id: dis.2.1
        name: "Graph basics"
        description: "Vertices, edges, degree, isomorphism."
        prerequisites: [fnd.2.5]
      - id: dis.2.2
        name: "Trees"
        description: "Acyclic connected graphs; spanning trees."
        prerequisites: [dis.2.1]
      - id: dis.2.4
        name: "Spectral graph theory"
        description: "Laplacian eigenvalues; Cheeger's inequality."
        prerequisites: [la.4.4, dis.2.1]
      - id: dis.2.5
        name: "Random graphs"
        description: "Erdős–Rényi G(n,p); thresholds."
        prerequisites: [dis.2.1, prob.1.4]
      - id: dis.2.6
        name: "Expander graphs"
        description: "High-connectivity sparse graphs."
        prerequisites: [dis.2.4, dis.1.4, dis.2.5]
      - id: dis.2.7
        name: "Graph algorithms"
        description: "Core traversal, path, and tree algorithms."
        children:
          - id: dis.2.7.1
            name: "Breadth-first search"
            description: "Level-order exploration; shortest paths in unweighted graphs."
            prerequisites: [dis.2.1]
          - id: dis.2.7.2
            name: "Depth-first search"
            description: "Recursive exploration; topological sort and cycle detection."
            prerequisites: [dis.2.1]
          - id: dis.2.7.3
            name: "Dijkstra's algorithm"
            description: "Greedy shortest paths for non-negative edge weights."
            prerequisites: [dis.2.7.1, dis.3.2]
          - id: dis.2.7.4
            name: "Bellman–Ford algorithm"
            description: "Dynamic-programming shortest paths allowing negative weights."
            prerequisites: [dis.2.7.3]
          - id: dis.2.7.5
            name: "Kruskal's algorithm"
            description: "Build an MST by adding cheapest edges that avoid cycles (union–find)."
            prerequisites: [dis.2.7.1]
          - id: dis.2.7.6
            name: "Prim's algorithm"
            description: "Grow an MST from a seed vertex by cheapest crossing edge (priority queue)."
            prerequisites: [dis.2.7.5]
      - id: dis.2.8
        name: "Message passing perspective"
        description: "Graph algorithms as iterative local updates; basis of GNNs."
        prerequisites: [dis.2.7]

  - id: dis.3
    name: "Algorithms"
    description: "Algorithm-design paradigms and data structures."
    children:
      - id: dis.3.1
        name: "Divide and conquer"
        description: "Recurrences; master theorem."
        prerequisites: [fnd.4.5, fnd.5.3]
      - id: dis.3.2
        name: "Dynamic programming"
        description: "Optimal substructure and memoization."
        prerequisites: [fnd.5.4]
      - id: dis.3.3
        name: "Greedy algorithms"
        description: "Exchange and matroid arguments."
        prerequisites: [fnd.5.3]
      - id: dis.3.4
        name: "Hashing"
        description: "Universal hashing; collision analysis."
        prerequisites: [prob.1.4]
      - id: dis.3.5
        name: "Sorting and order statistics"
        description: "Ordering data and finding ranks."
        children:
          - id: dis.3.5.1
            name: "Comparison sorting and lower bounds"
            description: "Mergesort / quicksort and the Ω(n log n) comparison lower bound."
            prerequisites: [dis.3.1]
          - id: dis.3.5.2
            name: "Order statistics and selection"
            description: "Find the k-th smallest in linear expected time (quickselect)."
            prerequisites: [dis.3.5.1]
      - id: dis.3.6
        name: "Streaming and sketches"
        description: "Sublinear-space summaries of large streams."
        children:
          - id: dis.3.6.1
            name: "Bloom filters"
            description: "Probabilistic set membership with one-sided error."
            prerequisites: [dis.3.4]
          - id: dis.3.6.2
            name: "Count-Min sketch"
            description: "Hash-based frequency estimation with bounded over-count."
            prerequisites: [dis.3.6.1, prob.6.3]
          - id: dis.3.6.3
            name: "HyperLogLog"
            description: "Cardinality estimation from leading-zero statistics."
            prerequisites: [dis.3.6.1]

  - id: dis.4
    name: "Computational complexity"
    description: "What computation can achieve under resource bounds."
    children:
      - id: dis.4.1
        name: "Turing machines and decidability"
        description: "(Cross-link to `fnd.5.1`/`fnd.5.2` with complexity flavor.)"
        prerequisites: [fnd.5.2, fnd.5.5.6]
      - id: dis.4.2
        name: "P, NP, NP-completeness"
        description: "Time-bounded computation; Cook–Levin."
        prerequisites: [dis.4.1, fnd.1.1.38, fnd.5.1.3]
      - id: dis.4.3
        name: "Polynomial-time reductions"
        description: "Mapping reductions; classes of equivalent problems."
        prerequisites: [dis.4.2]
      - id: dis.4.4
        name: "Approximation algorithms"
        description: "Approximation ratios; PCP overview."
        prerequisites: [dis.4.2, dis.4.3]
      - id: dis.4.6
        name: "Communication and circuit complexity (light)"
        description: "Lower bounds on attention / network expressivity."
        prerequisites: [dis.4.1, fnd.1.5.2]

  - id: dis.5
    name: "Descriptive / algorithmic complexity"
    description: "Description length and Kolmogorov complexity."
    children:
      - id: dis.5.1
        name: "Kolmogorov complexity"
        description: "Length of the shortest program producing a string."
        prerequisites: [dis.4.1]
      - id: dis.5.2
        name: "Minimum description length"
        description: "MDL principle; two-part codes."
        prerequisites: [dis.5.1, inf.2.2]
