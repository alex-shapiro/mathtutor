schema_version: 2
area: analysis
prefix: ana
summary: "Real and multivariate analysis, metric/topological spaces, functional analysis, measure theory, Fourier analysis, distributions, calculus of variations, complex analysis."
motivation: """
  Continuity, differentiability, and integration are the language of every
  loss function and gradient. Hilbert spaces and RKHS underlie kernel
  methods, NTK, and attention-as-kernel-smoothing. Measure theory is the
  rigorous home of probability and pushforward distributions. Fourier
  analysis underlies positional encoding, convolutional theory, and
  spectral arguments throughout.
  """
cross_references:
  - linear-algebra
  - probability
  - numerical
  - geometry-and-topology

children:
  - id: ana.1
    name: "Real analysis"
    description: "Limits, continuity, differentiation, and integration on the real line."
    children:
      - id: ana.1.1
        name: "Sequences and limits"
        description: "ε-N definition; bounded / monotone convergence."
        prerequisites: [fnd.2.3]
      - id: ana.1.2
        name: "Series and convergence tests"
        description: "Absolute vs conditional; comparison, ratio, root tests."
        prerequisites: [ana.1.1]
      - id: ana.1.3
        name: "Continuity"
        description: "Pointwise, uniform, Lipschitz; ε-δ formulations."
        prerequisites: [ana.1.1]
      - id: ana.1.4
        name: "Differentiability (single variable)"
        description: "Derivative as linear approximation."
        prerequisites: [ana.1.3]
      - id: ana.1.5
        name: "Riemann integration"
        description: "Darboux sums; fundamental theorem of calculus."
        prerequisites: [ana.1.4]
      - id: ana.1.6
        name: "Mean value theorems"
        description: "Rolle, Lagrange, and Cauchy mean value theorems."
        children:
          - id: ana.1.6.1
            name: "Rolle's theorem"
            description: "Equal endpoint values force a zero derivative in between."
            prerequisites: [ana.1.4]
          - id: ana.1.6.2
            name: "Lagrange mean value theorem"
            description: "The secant slope is attained by the derivative at an interior point."
            prerequisites: [ana.1.6.1]
          - id: ana.1.6.3
            name: "Cauchy mean value theorem"
            description: "Two-function generalization underlying l'Hôpital's rule."
            prerequisites: [ana.1.6.2]
      - id: ana.1.7
        name: "Taylor's theorem"
        description: "Polynomial approximation with remainder forms."
        prerequisites: [ana.1.6]
      - id: ana.1.8
        name: "Power series"
        description: "Radius of convergence; analytic functions."
        prerequisites: [ana.1.2]

  - id: ana.2
    name: "Multivariable calculus"
    description: "Differentiation and integration in several variables."
    children:
      - id: ana.2.1
        name: "Partial derivatives"
        description: "Direction-by-direction differentiation."
        prerequisites: [ana.1.4]
      - id: ana.2.2
        name: "Total / Fréchet derivative"
        description: "Best linear approximation; Jacobian."
        prerequisites: [ana.2.1, la.2.2]
      - id: ana.2.3
        name: "Multivariable chain rule"
        description: "Composition of Jacobians."
        prerequisites: [ana.2.2]
      - id: ana.2.4
        name: "Gradient, divergence, curl"
        description: "Vector calculus operators in ℝ³ / ℝᵈ."
        prerequisites: [ana.2.2]
      - id: ana.2.5
        name: "Multivariable Taylor expansion"
        description: "Hessian and higher-order tensors."
        prerequisites: [ana.1.7, ana.2.2]
      - id: ana.2.6
        name: "Inverse and implicit function theorems"
        description: "Local invertibility under regularity."
        prerequisites: [ana.2.2]
      - id: ana.2.7
        name: "Line and surface integrals"
        description: "Integration along curves and over surfaces."
        prerequisites: [ana.1.5, ana.2.4]
      - id: ana.2.8
        name: "Stokes / Green / divergence theorems"
        description: "The integral theorems of vector calculus."
        children:
          - id: ana.2.8.1
            name: "Green's theorem"
            description: "Circulation around a planar curve equals a double integral of curl."
            prerequisites: [ana.2.7]
          - id: ana.2.8.2
            name: "Divergence theorem"
            description: "Outward flux through a closed surface equals the volume integral of divergence."
            prerequisites: [ana.2.8.1]
          - id: ana.2.8.3
            name: "Stokes' theorem"
            description: "General form unifying Green, divergence, and the FTC via differential forms."
            prerequisites: [ana.2.8.2]
      - id: ana.2.9
        name: "Change of variables"
        description: "Jacobian determinant in multivariable integrals."
        prerequisites: [ana.2.6, la.2.6]

  - id: ana.3
    name: "Metric and topological spaces"
    description: "Abstract notions of nearness, openness, and compactness."
    children:
      - id: ana.3.1
        name: "Metric spaces and completeness"
        description: "Cauchy sequences; Banach fixed-point theorem."
        prerequisites: [ana.1.1]
      - id: ana.3.2
        name: "Open / closed sets"
        description: "Closure, interior, boundary."
        prerequisites: [ana.3.1]
      - id: ana.3.3
        name: "Compactness"
        description: "Heine–Borel; sequential compactness."
        prerequisites: [ana.3.2]
      - id: ana.3.4
        name: "Connectedness"
        description: "Connected and path-connected sets."
        prerequisites: [ana.3.2]
      - id: ana.3.5
        name: "Topological spaces"
        description: "Open sets as primitive structure."
        prerequisites: [ana.3.2]

  - id: ana.4
    name: "Functional analysis"
    description: "Infinite-dimensional spaces of functions and the operators on them."
    children:
      - id: ana.4.1
        name: "Banach spaces"
        description: "Complete normed vector spaces."
        prerequisites: [ana.3.1, la.3.2]
      - id: ana.4.2
        name: "Hilbert spaces"
        description: "Complete inner-product spaces; orthonormal bases."
        prerequisites: [ana.4.1, la.3.1]
      - id: ana.4.3
        name: "Bounded linear operators"
        description: "Operator norm; B(X,Y) as a Banach space."
        prerequisites: [ana.4.1, la.2.1, la.9]
      - id: ana.4.4
        name: "Dual spaces and Riesz representation"
        description: "Bounded linear functionals; Hilbert duality."
        prerequisites: [ana.4.2, fnd.3.3.5]
      - id: ana.4.7
        name: "Compact operators"
        description: "Limit of finite-rank; spectral structure."
        prerequisites: [ana.4.3]
      - id: ana.4.8
        name: "Spectral theorem (compact self-adjoint)"
        description: "Hilbert space generalization of `la.4.4`."
        prerequisites: [ana.4.7, la.4.4]
      - id: ana.4.9
        name: "Reproducing kernel Hilbert spaces"
        description: "RKHS; positive-definite kernels; representer theorem."
        prerequisites: [ana.4.2, ana.4.4, ana.4.8]
      - id: ana.4.10
        name: "Sobolev spaces (light)"
        description: "Weak derivatives; embeddings; PDE solution spaces."
        prerequisites: [ana.4.1, ana.7.3]

  - id: ana.5
    name: "Measure theory"
    description: "Rigorous foundations of length, area, and integration."
    children:
      - id: ana.5.1
        name: "σ-algebras and measurable spaces"
        description: "Closed under countable unions and complements."
        prerequisites: [fnd.2.5, fnd.2.1.8, fnd.2.1.13, fnd.2.4.6]
      - id: ana.5.2
        name: "Measures and Lebesgue measure"
        description: "Countably additive set functions; Lebesgue on ℝᵈ."
        prerequisites: [ana.5.1]
      - id: ana.5.3
        name: "Measurable functions"
        description: "Preimage of Borel sets is measurable."
        prerequisites: [ana.5.1, fnd.2.6]
      - id: ana.5.4
        name: "Lebesgue integral"
        description: "Constructed via simple functions; integrability."
        prerequisites: [ana.5.3]
      - id: ana.5.5
        name: "Convergence theorems"
        description: "Interchanging limits and Lebesgue integrals."
        children:
          - id: ana.5.5.1
            name: "Monotone convergence theorem"
            description: "Limits of increasing nonnegative functions pass into the integral."
            prerequisites: [ana.5.4]
          - id: ana.5.5.2
            name: "Dominated convergence theorem"
            description: "An integrable dominating function justifies the limit interchange."
            prerequisites: [ana.5.5.1]
          - id: ana.5.5.3
            name: "Fatou's lemma"
            description: "The integral of a liminf is at most the liminf of the integrals."
            prerequisites: [ana.5.5.1]
      - id: ana.5.6
        name: "Lᵖ spaces"
        description: "Hölder, Minkowski; Lᵖ as Banach (Hilbert if p=2)."
        prerequisites: [ana.5.4]
      - id: ana.5.7
        name: "Product measures and Fubini–Tonelli"
        description: "Iterated vs joint integrals."
        prerequisites: [ana.5.4]
      - id: ana.5.8
        name: "Radon–Nikodym theorem"
        description: "Density of one measure w.r.t. another."
        prerequisites: [ana.5.7]
      - id: ana.5.9
        name: "Pushforward measures"
        description: "Distribution of f(X) under a measure."
        prerequisites: [ana.5.4]
      - id: ana.5.10
        name: "Signed measures"
        description: "Hahn–Jordan decomposition."
        prerequisites: [ana.5.2]

  - id: ana.6
    name: "Fourier analysis"
    description: "Frequency-domain representation of functions and signals."
    children:
      - id: ana.6.1
        name: "Fourier series"
        description: "Orthogonal expansion on the circle."
        prerequisites: [ana.4.2]
      - id: ana.6.2
        name: "Fourier transform on ℝᵈ"
        description: "Continuous spectral decomposition."
        prerequisites: [ana.5.6]
      - id: ana.6.3
        name: "Plancherel / Parseval identities"
        description: "Energy preservation under Fourier transform."
        prerequisites: [ana.6.2]
      - id: ana.6.4
        name: "Convolution theorem"
        description: "Convolution becomes pointwise multiplication."
        prerequisites: [ana.6.2]
      - id: ana.6.5
        name: "Sampling theorem"
        description: "Nyquist–Shannon reconstruction."
        prerequisites: [ana.6.2]
      - id: ana.6.6
        name: "DFT and FFT"
        description: "Discrete analogue; O(n log n) algorithm."
        prerequisites: [ana.6.1, ana.6.5]
      - id: ana.6.7
        name: "Wavelets"
        description: "Multi-resolution analysis; localized basis."
        prerequisites: [ana.6.1]
      - id: ana.6.8
        name: "Schwartz space and tempered distributions"
        description: "Rapidly decaying functions; Fourier-stable."
        prerequisites: [ana.6.2]

  - id: ana.7
    name: "Distribution theory"
    description: "Generalized functions and weak derivatives."
    children:
      - id: ana.7.1
        name: "Test functions"
        description: "Smooth, compactly supported."
        prerequisites: [ana.1.4]
      - id: ana.7.2
        name: "Distributions / generalized functions"
        description: "Continuous linear functionals on test functions."
        prerequisites: [ana.7.1]
      - id: ana.7.3
        name: "Weak derivatives"
        description: "Derivatives in the distributional sense."
        prerequisites: [ana.7.2]
      - id: ana.7.4
        name: "Dirac delta"
        description: "Point evaluation as a distribution."
        prerequisites: [ana.7.2, ana.6.8]

  - id: ana.8
    name: "Calculus of variations"
    description: "Optimization over spaces of functions."
    children:
      - id: ana.8.1
        name: "Functionals and variations"
        description: "Optimization over function spaces."
        prerequisites: [ana.2.5]
      - id: ana.8.2
        name: "Euler–Lagrange equations"
        description: "First-order conditions for variational problems."
        prerequisites: [ana.8.1]

  - id: ana.9
    name: "Complex analysis (light)"
    description: "Differentiable functions of a complex variable."
    children:
      - id: ana.9.1
        name: "Holomorphic functions"
        description: "Complex differentiability; rigidity."
        prerequisites: [ana.1.4]
      - id: ana.9.2
        name: "Cauchy–Riemann equations"
        description: "PDE characterization of holomorphy."
        prerequisites: [ana.9.1]
      - id: ana.9.3
        name: "Contour integration and residues"
        description: "Closed-curve integrals; pole contributions."
        prerequisites: [ana.9.2]
      - id: ana.9.4
        name: "Analytic continuation"
        description: "Uniqueness of extension; Riemann surfaces."
        prerequisites: [ana.9.3]
